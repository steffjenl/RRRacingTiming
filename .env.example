# Base host used by Apex Timing live client
APEX_HOST=www.apex-timing.com

# Base port from detected site config
APEX_PORT=9460

# GMT offset from detected site config
APEX_GMT=2

# Set true when you want secure wss defaults
APEX_SECURE=false

# Optional absolute websocket endpoint override
# APEX_WS_URL=wss://www.apex-timing.com:9463/

# Optional absolute polling endpoint override
# APEX_POLLING_URL=https://example.com/commonv2/functions/live_ajax.php

# Web server port for dashboard mode
WEB_PORT=3000

# Number of reverse proxies in front of Express; set to 1 for NPMplus / Nginx Proxy Manager
# WEB_TRUST_PROXY=1

# Set debug logging in web mode with LOG_LEVEL=debug
# LOG_LEVEL=info

# Optional web persistence paths
# WEB_SAVE_RAW=logs/web-raw.jsonl
# WEB_SAVE_NORMALIZED=logs/web-normalized.jsonl
# WEB_SNAPSHOT_PATH=logs/state-snapshots.jsonl
